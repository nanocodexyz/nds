{
  "name": "nds",
  "version": "0.1.0",
  "private": true,
  "description": "nanocode design system",
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/nanocodexyz/nds",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "check:types": "tsc --noEmit && tsc --noEmit -p playground",
    "dev": "vite playground",
    "playground:build": "vite build playground",
    "release": "node scripts/release.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/Agent.d.ts",
      "default": "./dist/Agent.js"
    },
    "./clones": {
      "types": "./dist/Clones.d.ts",
      "default": "./dist/Clones.js"
    },
    "./fonts/CommitMono-VF.woff2": "./dist/fonts/CommitMono-VF.woff2",
    "./highlight": {
      "types": "./dist/Highlight.d.ts",
      "default": "./dist/Highlight.js"
    },
    "./site": {
      "types": "./dist/Site.d.ts",
      "default": "./dist/Site.js"
    },
    "./skin": {
      "types": "./dist/Skin.d.ts",
      "default": "./dist/Skin.js"
    },
    "./themes": {
      "types": "./dist/Themes.d.ts",
      "default": "./dist/Themes.js"
    },
    "./zyzz.css": "./dist/zyzz.css"
  },
  "dependencies": {
    "zyzz": "0.0.40"
  },
  "peerDependencies": {
    "@pierre/highlights": "^0.2.0",
    "nanocode-ts": "*",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@pierre/highlights": {
      "optional": true
    },
    "nanocode-ts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pierre/highlights": "0.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "nanocode-ts": "https://github.com/nanocodexyz/nanocode-ts/releases/download/build-07238e5/nanocode-ts-07238e5.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.2",
    "vite": "8.3.4"
  }
}
